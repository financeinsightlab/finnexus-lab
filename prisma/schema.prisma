generator client {
  provider        = "prisma-client-js"
  engineType      = "client"
  previewFeatures = ["queryCompiler", "driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  email                  String?                 @unique
  emailVerified          DateTime?
  image                  String?
  password               String?
  customBadge            String?
  role                   UserRole                @default(MEMBER)
  stripeCustomerId       String?                 @unique
  stripeSubscriptionId   String?                 @unique
  subscriptionStatus     SubscriptionStatus      @default(INACTIVE)
  subscriptionPlan       String?
  // Manual UPI approvals expire after one calendar month; null preserves legacy/admin grants.
  subscriptionExpiresAt  DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  purchasedServices      String[]
  accounts               Account[]
  posts                  Post[]
  savedArticles          SavedArticle[]
  sessions               Session[]
  predictions            Prediction[]
  comments               Comment[]
  analystScore           AnalystScore?
  // Enhanced CMS relations
  media                  Media[]                 @relation("UserMedia")
  blockTemplates         BlockTemplate[]         @relation("UserTemplates")
  pages                  Page[]
  // Study Material relations
  studyMaterials         StudyMaterial[]
  // ─── V2: organisations, community & learning ───────────────────────────────
  memberships            Membership[]
  apiKeys                ApiKey[]
  commentReactions       CommentReaction[]
  profile                Profile?
  following              Follow[]                @relation("UserFollowing")
  followers              Follow[]                @relation("UserFollowers")
  notifications          Notification[]
  notificationPreference NotificationPreference?
  paymentSubmissions     PaymentSubmission[]
  paymentsVerified      PaymentSubmission[]       @relation("PaymentsVerified")
  paymentAuditEvents     PaymentAuditEvent[]      @relation("PaymentAuditActor")
  enrollments            Enrollment[]
  lessonProgress         LessonProgress[]
  badges                 UserBadge[]
  assessmentAttempts     CourseAssessmentAttempt[]
  courseCertificates     CourseCertificate[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SavedArticle {
  id      String   @id @default(cuid())
  userId  String
  slug    String
  type    String
  savedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug, type])
}

model Post {
  id                   String         @id @default(cuid())
  title                String
  slug                 String         @unique
  excerpt              String?
  content              String
  type                 ArticleType    @default(RESEARCH)
  published            Boolean        @default(false)
  featuredImage        String?
  authorId             String
  seoTitle             String?
  metaDescription      String?
  focusKeywords        String?
  ogImage              String?
  ogTitle              String?
  tags                 String[]       @default([])
  difficulty           String         @default("INTERMEDIATE")
  targetAudience       String[]       @default([])
  contentStatus        String         @default("DRAFT") // DRAFT, REVIEW, APPROVED, PUBLISHED
  estimatedReadingTime Int            @default(5)
  scheduledPublishAt   DateTime?
  viewCount            Int            @default(0)
  publishedAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  author               User           @relation(fields: [authorId], references: [id])
  comments             Comment[]
  // Enhanced CMS fields
  blockContent         Json? // Alternative to markdown content for block-based editing
  contentType          String         @default("MARKDOWN") // MARKDOWN or BLOCKS
  media                Media[]        @relation("PostMedia")
  blocks               ContentBlock[] @relation("PostBlocks")

  @@index([type])
  @@index([published])
  @@index([slug])
}

// ─── ENHANCED CMS MODELS ──────────────────────────────────────────────────────

model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  path         String // Relative path from public/uploads
  url          String // Full URL
  mimeType     String
  size         Int // Bytes
  width        Int?
  height       Int?
  altText      String?
  caption      String?
  description  String?
  uploadedBy   String // User ID
  uploadedAt   DateTime @default(now())
  metadata     Json? // EXIF data, etc.

  // Relationships
  user  User   @relation("UserMedia", fields: [uploadedBy], references: [id])
  posts Post[] @relation("PostMedia")

  @@index([uploadedAt])
  @@index([mimeType])
  @@index([uploadedBy])
}

model ContentBlock {
  id         String   @id @default(cuid())
  type       String // paragraph, heading, image, columns, etc.
  data       Json // Block-specific data
  attributes Json? // Style attributes
  order      Int // Position in parent
  parentId   String? // For nested blocks
  postId     String? // If attached to a post
  pageId     String? // If attached to a page
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relationships
  post     Post?          @relation("PostBlocks", fields: [postId], references: [id])
  page     Page?          @relation("PageBlocks", fields: [pageId], references: [id])
  parent   ContentBlock?  @relation("BlockParent", fields: [parentId], references: [id])
  children ContentBlock[] @relation("BlockParent")

  @@index([postId])
  @@index([pageId])
  @@index([parentId])
  @@index([type])
  @@index([order])
}

model BlockTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String // section, component, layout
  preview     String? // Preview image URL
  data        Json // Block data structure
  category    String // hero, feature, cta, etc.
  isPublic    Boolean  @default(true)
  createdBy   String // User ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  user User @relation("UserTemplates", fields: [createdBy], references: [id])

  @@index([category])
  @@index([type])
  @@index([isPublic])
  @@index([createdBy])
}

model Page {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  content         Json? // Block-based content
  htmlContent     String? // Rendered HTML (cached)
  status          PageStatus @default(DRAFT)
  seoTitle        String?
  metaDescription String?
  featuredImage   String?
  authorId        String
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relationships
  author User           @relation(fields: [authorId], references: [id])
  blocks ContentBlock[] @relation("PageBlocks")

  @@index([slug])
  @@index([status])
  @@index([authorId])
  @@index([publishedAt])
}

enum PageStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

model PageView {
  id         String   @id @default(cuid())
  path       String
  userId     String?
  sessionId  String
  durationMs Int      @default(0)
  referrer   String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([path])
  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([sessionId, path]) // Composite index for upsert queries
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  provider  String   @default("credentials")
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([provider]) // For groupBy queries on provider
}

// Manual UPI payment submissions. No card data or screenshot files are stored.
model PaymentSubmission {
  id                    String                @id @default(cuid())
  userId                String?
  user                  User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  plan                  String
  amountMinor           Int
  currency              String                @default("INR")
  paymentMethod         PaymentMethod         @default(MANUAL_UPI)
  transactionReference String                @unique
  status                PaymentStatus         @default(PENDING)
  // Set while pending to prevent multiple simultaneous submissions for one user.
  activeKey             String?               @unique
  submittedAt           DateTime              @default(now())
  verifiedAt            DateTime?
  verifiedById          String?
  verifiedBy            User?                 @relation("PaymentsVerified", fields: [verifiedById], references: [id], onDelete: SetNull)
  rejectionReason       String?
  expiresAt             DateTime?
  auditEvents           PaymentAuditEvent[]

  @@index([userId, submittedAt])
  @@index([userId, status])
  @@index([status, submittedAt])
  @@index([verifiedById])
}

model PaymentAuditEvent {
  id         String             @id @default(cuid())
  paymentId  String
  payment    PaymentSubmission  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  actorId    String?
  actor      User?              @relation("PaymentAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     PaymentAuditAction
  fromStatus PaymentStatus?
  toStatus   PaymentStatus
  reason     String?
  createdAt  DateTime           @default(now())

  @@index([paymentId, createdAt])
  @@index([actorId, createdAt])
}

// Database-backed fixed-window throttling works across serverless instances.
model RateLimitBucket {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime
  updatedAt       DateTime @updatedAt
}

model FeaturedContent {
  id        String   @id
  section   String
  contentId String
  order     Int
  updatedAt DateTime
  createdAt DateTime @default(now())

  @@unique([section, contentId])
  @@index([section, order])
}

model HomePageAuditLog {
  id        String   @id
  action    String
  section   String?
  itemId    String?
  userId    String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([section])
  @@index([userId])
}

model HomePageConfig {
  id        String          @id
  section   HomePageSection @unique
  config    Json
  enabled   Boolean         @default(true)
  order     Int
  updatedAt DateTime
  createdAt DateTime        @default(now())

  @@index([enabled])
  @@index([order])
  @@index([section])
}

model HomePageItem {
  id          String   @id
  section     String
  title       String
  subtitle    String?
  description String?
  icon        String?
  link        String?
  color       String?
  order       Int
  enabled     Boolean  @default(true)
  updatedAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([section, order])
  @@index([section, enabled])
  @@index([section])
  @@index([section, order])
}

enum UserRole {
  MEMBER
  VIEWER
  ADMIN
  ANALYST
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  MANUAL_UPI
}

enum PaymentAuditAction {
  SUBMITTED
  APPROVED
  REJECTED
}

enum ArticleType {
  RESEARCH
  INSIGHT
  CASE_STUDY
  MEDIA
  OTHER
}

enum HomePageSection {
  RESEARCH
  INSIGHTS
  PILLARS
  TRACKERS
  PODCAST
  HERO_STATS
}

// ─── ANALYST CALIBRATION SCORE ────────────────────────────────────────────────

enum PredictionStatus {
  PENDING
  CONFIRMED
  INCORRECT
  PARTIAL
}

model Prediction {
  id             String           @id @default(cuid())
  slug           String           @unique
  authorId       String
  author         User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  claim          String // The prediction text
  sector         String
  resolveDate    DateTime
  status         PredictionStatus @default(PENDING)
  resolutionNote String?
  reportSlug     String? // Which post/report it came from
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  comments       Comment[]

  @@index([authorId])
  @@index([status])
  @@index([sector])
  @@index([resolveDate])
}

model AnalystScore {
  id               String   @id @default(cuid())
  authorId         String   @unique
  author           User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  totalPredictions Int      @default(0)
  confirmed        Int      @default(0)
  incorrect        Int      @default(0)
  partial          Int      @default(0)
  calibrationScore Float    @default(0)
  longestStreak    Int      @default(0)
  lastCalculated   DateTime @default(now())

  @@index([authorId])
  @@index([calibrationScore])
}

// ─── COMMENTS & COMMUNITY ──────────────────────────────────────────────────────

model Comment {
  id           String            @id @default(cuid())
  content      String
  authorId     String
  author       User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId       String?
  post         Post?             @relation(fields: [postId], references: [id], onDelete: Cascade)
  predictionId String?
  prediction   Prediction?       @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  // ─── Comments 2.0 (Pillar D): threads, mentions, moderation, reactions ─────
  parentId     String?
  parent       Comment?          @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]         @relation("CommentThread")
  mentions     String[]          @default([]) // User IDs referenced with @mention
  status       String            @default("VISIBLE") // VISIBLE, HIDDEN, DELETED
  editedAt     DateTime?
  reactions    CommentReaction[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([authorId])
  @@index([postId])
  @@index([predictionId])
  @@index([parentId])
  @@index([createdAt])
}

model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String   @default("👍")
  createdAt DateTime @default(now())

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@index([userId])
}

// ─── ORGANISATIONS, MEMBERSHIP & API KEYS (Pillar A4/A5) ──────────────────────

model Organization {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  plan             String       @default("TEAM")
  stripeCustomerId String?      @unique
  seats            Int          @default(5)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  memberships      Membership[]
  apiKeys          ApiKey[]

  @@index([slug])
}

model Membership {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role      String       @default("MEMBER") // OWNER, ADMIN, MEMBER
  createdAt DateTime     @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
}

model ApiKey {
  id              String        @id @default(cuid())
  name            String
  prefix          String        @unique // non-secret display prefix, e.g. ka_live_ab12
  hash            String // SHA-256 of the secret material
  scopes          String[]      @default([])
  rateLimitPerMin Int?
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  orgId           String?
  org             Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([userId])
  @@index([orgId])
  @@index([revokedAt])
}

// ─── PUBLIC PROFILES, FOLLOWS, NOTIFICATIONS & GAMIFICATION (Pillar D2/D3/D4) ─

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline  String?
  bio       String?
  location  String?
  website   String?
  twitter   String?
  linkedin  String?
  github    String?
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // comment, reply, mention, follow, badge, system
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailDigest    Boolean  @default(true)
  productUpdates Boolean  @default(true)
  comments       Boolean  @default(true)
  follows        Boolean  @default(true)
  marketing      Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  icon        String      @default("🏅")
  points      Int         @default(0)
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([badgeId])
}

// ─── PERSISTED LEARNING PROGRESS (Pillar E1) ─────────────────────────────────

model Enrollment {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseSlug     String
  trackSlug      String?
  status         String    @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED
  startedAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  completedAt    DateTime?

  @@unique([userId, courseSlug])
  @@index([userId])
  @@index([status])
}

model LessonProgress {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseSlug   String
  lessonSlug   String
  completed    Boolean   @default(false)
  secondsSpent Int       @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([userId, courseSlug, lessonSlug])
  @@index([userId])
  @@index([courseSlug])
}

// ─── BACKGROUND JOBS & PUBLISH PIPELINE (Pillar G3/G4) ───────────────────────

model Job {
  id         String    @id @default(cuid())
  type       String
  payload    Json?
  status     String    @default("PENDING") // PENDING, RUNNING, DONE, FAILED
  attempts   Int       @default(0)
  runAt      DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?
  createdAt  DateTime  @default(now())

  @@index([status, runAt])
  @@index([type])
}

model PublishEvent {
  id          String   @id @default(cuid())
  entityType  String // post, page, study
  entityId    String
  slug        String?
  action      String // created, updated, published, unpublished, deleted
  revalidated Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([entityType])
  @@index([createdAt])
}

// ─── STUDY MATERIAL ───────────────────────────────────────────────────────────

model StudyMaterial {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String
  content     String // Markdown or rich text
  categoryId  String
  category    StudyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  type        String        @default("ARTICLE") // ARTICLE, VIDEO, PDF, COURSE, NOTE
  difficulty  String        @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED
  tags        String[]      @default([])
  coverImage  String?
  resourceUrl String? // External link to PDF, video, etc.
  duration    Int? // Estimated minutes
  published   Boolean       @default(false)
  featured    Boolean       @default(false)
  viewCount        Int           @default(0)
  publishedAt      DateTime?
  learningOutcomes String[]      @default([])
  prerequisites    String[]      @default([])
  createdAt        DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId])
  @@index([published])
  @@index([slug])
  @@index([type])
  @@index([difficulty])
  @@index([featured])
  @@index([publishedAt])
}

model StudyCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String? // Emoji or icon name
  color       String? // Theme color
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  materials StudyMaterial[]

  @@index([slug])
  @@index([order])
}

// ─── Product content: managed FAQs, finance terms and relationships ────────────

model FaqItem {
  id            String   @id @default(cuid())
  slug          String
  question      String
  answer        String   @db.Text
  category      String?
  relatedType   String
  relatedSlug   String
  displayOrder  Int      @default(0)
  published     Boolean  @default(false)
  seoVisible    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([relatedType, relatedSlug, slug])
  @@index([relatedType, relatedSlug, published, displayOrder])
  @@index([published, seoVisible])
}

model FinanceTerm {
  id                String   @id @default(cuid())
  slug              String   @unique
  term              String
  simpleMeaning     String   @db.Text
  example           String   @db.Text
  interviewAnswer   String   @db.Text
  formula           String?  @db.Text
  category          String
  subCategory       String?
  difficulty        String   @default("BEGINNER")
  keywords          String[] @default([])
  synonyms          String[] @default([])
  relatedTermSlugs  String[] @default([])
  searchText        String   @default("") @db.Text
  featured          Boolean  @default(false)
  published         Boolean  @default(false)
  seoVisible        Boolean  @default(true)
  displayOrder      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([published, displayOrder])
  @@index([category, published, displayOrder])
  @@index([featured, published])
}

model RelatedContent {
  id          String   @id @default(cuid())
  sourceType  String
  sourceSlug  String
  targetType  String
  targetSlug  String
  anchorText  String?
  linkKind    String   @default("RELATED")
  displayOrder Int     @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sourceType, sourceSlug, targetType, targetSlug])
  @@index([sourceType, sourceSlug, published, displayOrder])
  @@index([targetType, targetSlug])
}

// ─── Course content, assessments and un-signed completion records ─────────────

model CourseLesson {
  id              String   @id @default(cuid())
  courseSlug      String
  slug            String
  title           String
  summary         String?
  content         String   @db.Text
  durationMinutes Int?
  displayOrder    Int      @default(0)
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([courseSlug, slug])
  @@index([courseSlug, published, displayOrder])
}

model CourseAssessment {
  id              String   @id @default(cuid())
  courseSlug      String   @unique
  title           String
  instructions    String?  @db.Text
  passPercentage  Int      @default(70)
  maxAttempts     Int?
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  questions       CourseAssessmentQuestion[]
  attempts        CourseAssessmentAttempt[]

  @@index([published])
}

model CourseAssessmentQuestion {
  id               String   @id @default(cuid())
  assessmentId     String
  assessment       CourseAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  prompt           String   @db.Text
  options          Json
  correctOption    Int
  explanation      String   @db.Text
  marks            Int      @default(1)
  displayOrder     Int      @default(0)
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([assessmentId, displayOrder])
}

model CourseAssessmentAttempt {
  id            String   @id @default(cuid())
  assessmentId  String
  assessment    CourseAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptNumber Int
  score         Int
  maxScore      Int
  percentage    Int
  passed        Boolean  @default(false)
  submittedAt   DateTime @default(now())

  @@unique([assessmentId, userId, attemptNumber])
  @@index([assessmentId, userId, submittedAt])
  @@index([userId, passed])
}

model CourseCertificate {
  id            String   @id @default(cuid())
  certificateId String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseSlug    String
  studentName   String
  courseTitle   String
  completedAt   DateTime
  issuedAt      DateTime @default(now())
  status        String   @default("ACTIVE")

  @@unique([userId, courseSlug])
  @@index([status, issuedAt])
}

// ─── Scheduled partner promotions and aggregate, non-personal event records ──

model Promotion {
  id                    String   @id @default(cuid())
  brandName             String
  title                 String
  shortDescription      String
  fullDescription       String?  @db.Text
  logoUrl               String?
  imageUrl              String?
  lightCreativeUrl      String?
  darkCreativeUrl       String?
  videoUrl              String?
  ctaText               String   @default("Learn more")
  destinationUrl        String
  affiliateUrl          String?
  trackingUrl           String?
  category              String
  placement             String
  targetPages           String[] @default([])
  targetContentTypes    String[] @default([])
  startsAt              DateTime?
  endsAt                DateTime?
  active                Boolean  @default(false)
  priority              Int      @default(0)
  displayFrequency      Int      @default(1)
  mobileVisible         Boolean  @default(true)
  desktopVisible        Boolean  @default(true)
  disclosureType        String   @default("SPONSORED")
  disclosureText        String   @default("Sponsored · Paid promotion")
  campaignId            String?
  utmParameters         Json?
  conversionTrackingUrl String?
  // ── Targeting engine (additive) ──
  // Device: mobile/tablet/desktop flags; theme: ALL | LIGHT | DARK;
  // rotation: PRIORITY | ROTATE | WEIGHTED | RANDOM; frequencyCap: max viewable
  // impressions per visitor per 24h (null = unlimited, enforced first-party).
  tabletVisible         Boolean  @default(true)
  themeMode             String   @default("ALL")
  rotationMode          String   @default("PRIORITY")
  frequencyCap          Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  events                PromotionEvent[]
  targets               PromotionTarget[]
  placements            PromotionPlacement[]

  @@index([placement, active, priority])
  @@index([startsAt, endsAt])
  @@index([category])
  @@index([campaignId])
}

/// One targeting rule of a promotion. A promotion has many rules; INCLUDE rules
/// are OR-ed, EXCLUDE rules always win. targetType: GLOBAL | PATH | PAGE_TYPE |
/// CONTENT | TAG. targetValue holds the normalised path, page type key,
/// `TYPE:slug` content key or lower-cased tag.
model PromotionTarget {
  id                 String    @id @default(cuid())
  promotionId        String
  promotion          Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  mode               String    @default("INCLUDE")
  targetType         String
  targetValue        String    @default("")
  includeDescendants Boolean   @default(false)
  createdAt          DateTime  @default(now())

  @@unique([promotionId, mode, targetType, targetValue])
  @@index([targetType, targetValue])
}

/// One slot assignment of a promotion (many-to-many). `weight` drives weighted rotation.
model PromotionPlacement {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  slot        String
  weight      Int       @default(1)
  createdAt   DateTime  @default(now())

  @@unique([promotionId, slot])
  @@index([slot])
}

model PromotionEvent {
  id          String   @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  eventType   String
  path        String
  slot        String?
  device      String?
  pageType    String?
  createdAt   DateTime @default(now())

  @@index([promotionId, eventType, createdAt])
  @@index([path, createdAt])
  @@index([slot, createdAt])
}
